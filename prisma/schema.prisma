generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentProvider {
  MIDTRANS
  MANUAL
}

enum PaymentChannel {
  SNAP_ALL
  QRIS
  GOPAY
  BANK_TRANSFER
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  CAPTURE
  SETTLEMENT
  DENY
  CANCEL
  EXPIRE
  FAILURE
  REFUND
  CHARGEBACK
  PARTIAL_REFUND
  PARTIAL_CHARGEBACK
  AUTHORIZE
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model PaymentTransaction {
  id                    String          @id @default(uuid())
  orderId               String          @map("order_id") // External order/invoice ID from calling service
  amount                Decimal         @map("gross_amount") @db.Decimal(12, 2)
  currency              String          @default("IDR")
  organizationId        String?         @map("organization_id")
  description           String?
  metadata              Json?
  provider              PaymentProvider @default(MIDTRANS)
  channel               PaymentChannel  @default(SNAP_ALL)
  status                PaymentStatus   @default(PENDING)
  midtransOrderId       String          @unique @map("midtrans_order_id")
  midtransTransactionId String?         @map("midtrans_transaction_id")
  snapToken             String?         @map("snap_token")
  snapRedirectUrl       String?         @map("snap_redirect_url")
  vaBank                String?         @map("va_bank")
  vaNumber              String?         @map("va_number")
  vaExpiryTime          DateTime?       @map("va_expiry_time")
  signatureKey          String?         @map("signature_key")
  requestPayload        Json?           @map("request_payload")
  rawResponse           Json?           @map("raw_response")
  paidAt                DateTime?       @map("paid_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_transactions")
}

model WebhookEvent {
  id           String   @id @default(uuid())
  provider     String   @default("MIDTRANS")
  eventId      String   @unique @map("event_id") // transaction_id
  orderId      String   @map("order_id")
  signatureKey String   @map("signature_key")
  payload      Json
  processedAt  DateTime @default(now()) @map("processed_at")

  @@map("webhook_events")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       @map("aggregate_type") // INVOICE
  aggregateId   String       @map("aggregate_id") // invoiceId
  eventType     String       @map("event_type") // INVOICE_PAID, INVOICE_EXPIRED
  payload       Json
  status        OutboxStatus @default(PENDING)
  createdAt     DateTime     @default(now()) @map("created_at")
  processedAt   DateTime?    @map("processed_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model VirtualAccountBank {
  id        String   @id
  code      String   @unique
  name      String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("virtual_account_banks")
}

enum MutationType {
  CREDIT
  DEBIT
}

enum MutationCategory {
  PAYMENT_SETTLEMENT
  PAYOUT
  FEE
  ADJUSTMENT
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

model TenantBalance {
  id               String   @id @default(uuid())
  organizationId   String   @unique @map("organization_id")
  currency         String   @default("IDR")
  availableBalance Decimal  @default(0) @map("available_balance") @db.Decimal(14, 2)
  pendingBalance   Decimal  @default(0) @map("pending_balance") @db.Decimal(14, 2)
  lockedBalance    Decimal  @default(0) @map("locked_balance") @db.Decimal(14, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("tenant_balances")
}

model BalanceMutation {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  type           MutationType
  category       MutationCategory
  amount         Decimal          @db.Decimal(14, 2)
  balanceBefore  Decimal          @map("balance_before") @db.Decimal(14, 2)
  balanceAfter   Decimal          @map("balance_after") @db.Decimal(14, 2)
  referenceId    String?          @map("reference_id")
  description    String?
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([referenceId])
  @@map("balance_mutations")
}

model PayoutRequest {
  id                String       @id @default(uuid())
  organizationId    String       @map("organization_id")
  amount            Decimal      @db.Decimal(14, 2)
  currency          String       @default("IDR")
  bankCode          String       @map("bank_code")
  bankAccountNumber String       @map("bank_account_number")
  bankAccountName   String       @map("bank_account_name")
  status            PayoutStatus @default(PENDING)
  referenceNo       String       @unique @map("reference_no")
  rejectedReason    String?      @map("rejected_reason")
  approvedAt        DateTime?    @map("approved_at")
  completedAt       DateTime?    @map("completed_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([createdAt])
  @@map("payout_requests")
}
