{
  "components": {
    "schemas": {
      "CreateQrPaymentDto": {
        "properties": {
          "amount": {
            "description": "Amount in IDR",
            "example": 150000,
            "minimum": 1,
            "type": "number"
          },
          "currency": {
            "default": "IDR",
            "example": "IDR",
            "type": "string"
          },
          "customerEmail": {
            "description": "Customer email",
            "example": "john@example.com",
            "type": "string"
          },
          "customerName": {
            "description": "Customer name",
            "example": "John Doe",
            "type": "string"
          },
          "description": {
            "description": "Payment description",
            "example": "QRIS payment",
            "type": "string"
          },
          "metadata": {
            "description": "Arbitrary context metadata",
            "example": {
              "planId": "plan-pro"
            },
            "type": "object"
          },
          "orderId": {
            "description": "External order/invoice reference from calling service",
            "example": "ORD-20261024-0001",
            "type": "string"
          }
        },
        "required": [
          "orderId",
          "amount"
        ],
        "type": "object"
      },
      "CreateSnapPaymentDto": {
        "properties": {
          "amount": {
            "description": "Amount in IDR",
            "example": 150000,
            "minimum": 1,
            "type": "number"
          },
          "channel": {
            "default": "SNAP_ALL",
            "description": "Preferred payment channel",
            "enum": [
              "SNAP_ALL",
              "QRIS",
              "GOPAY",
              "BANK_TRANSFER",
              "CREDIT_CARD"
            ],
            "type": "string"
          },
          "currency": {
            "default": "IDR",
            "example": "IDR",
            "type": "string"
          },
          "customerEmail": {
            "description": "Customer email",
            "example": "john@example.com",
            "type": "string"
          },
          "customerName": {
            "description": "Customer name",
            "example": "John Doe",
            "type": "string"
          },
          "customerPhone": {
            "description": "Customer phone number",
            "example": "081234567890",
            "type": "string"
          },
          "description": {
            "description": "Payment description",
            "example": "Subscription payment",
            "type": "string"
          },
          "metadata": {
            "description": "Arbitrary context metadata",
            "example": {
              "planId": "plan-pro",
              "userId": "user-123"
            },
            "type": "object"
          },
          "orderId": {
            "description": "External order/invoice reference from calling service",
            "example": "ORD-20261024-0001",
            "type": "string"
          }
        },
        "required": [
          "orderId",
          "amount"
        ],
        "type": "object"
      },
      "CreateVaPaymentDto": {
        "properties": {
          "amount": {
            "description": "Amount in IDR",
            "example": 150000,
            "minimum": 1,
            "type": "number"
          },
          "bank": {
            "description": "Midtrans bank used to create the virtual account",
            "enum": [
              "bca",
              "bni",
              "bri",
              "cimb",
              "permata"
            ],
            "example": "bca",
            "type": "string"
          },
          "currency": {
            "default": "IDR",
            "example": "IDR",
            "type": "string"
          },
          "customerEmail": {
            "description": "Customer email",
            "example": "john@example.com",
            "type": "string"
          },
          "customerName": {
            "description": "Customer name",
            "example": "John Doe",
            "type": "string"
          },
          "description": {
            "description": "Payment description",
            "example": "Bank transfer VA payment",
            "type": "string"
          },
          "metadata": {
            "description": "Arbitrary context metadata",
            "example": {
              "planId": "plan-pro"
            },
            "type": "object"
          },
          "orderId": {
            "description": "External order/invoice reference from calling service",
            "example": "ORD-20261024-0001",
            "type": "string"
          }
        },
        "required": [
          "orderId",
          "amount",
          "bank"
        ],
        "type": "object"
      },
      "GenerateSignatureDto": {
        "properties": {
          "body": {
            "description": "Request body JSON payload (for POST/PUT methods)",
            "example": {
              "amount": 150000,
              "orderId": "ORD-20261024-0001"
            },
            "type": "object"
          },
          "method": {
            "description": "HTTP method of the target request (GET, POST, etc.)",
            "example": "POST",
            "type": "string"
          },
          "path": {
            "description": "Path of the target endpoint",
            "example": "/api/v1/payments/snap",
            "type": "string"
          },
          "timestamp": {
            "description": "Timestamp (ISO-8601 or epoch ms). If omitted, current timestamp is generated automatically.",
            "example": "2026-10-24T14:00:00.000Z",
            "type": "object"
          }
        },
        "required": [
          "method",
          "path"
        ],
        "type": "object"
      },
      "GenerateSignatureResponseDto": {
        "properties": {
          "headers": {
            "description": "Ready-to-use HTTP headers for calling billing-service endpoints",
            "example": {
              "X-Api-Key": "sb-api-key-test",
              "X-Signature": "c8afa9531677496ab9ab7e971cda7249a8f5c34e595e3d0aacb865f4a13cba7b",
              "X-Timestamp": "2026-10-24T14:00:00.000Z"
            },
            "type": "object"
          },
          "payloadToSign": {
            "description": "Formatted payload that was hashed with HMAC-SHA256",
            "example": "POST:/api/v1/payments/snap:2026-10-24T14:00:00.000Z:a8f5c3...",
            "type": "string"
          },
          "signature": {
            "description": "Generated HMAC-SHA256 signature",
            "example": "c8afa9531677496ab9ab7e971cda7249a8f5c34e595e3d0aacb865f4a13cba7b",
            "type": "string"
          },
          "timestamp": {
            "description": "Timestamp used in signature calculation",
            "example": "2026-10-24T14:00:00.000Z",
            "type": "string"
          }
        },
        "required": [
          "signature",
          "timestamp",
          "payloadToSign",
          "headers"
        ],
        "type": "object"
      },
      "ListPaymentOrdersResponseDto": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/PaymentOrderResponseDto"
            },
            "type": "array"
          },
          "page": {
            "example": 1,
            "type": "number"
          },
          "pageSize": {
            "example": 50,
            "type": "number"
          },
          "total": {
            "example": 1250,
            "type": "number"
          }
        },
        "required": [
          "data",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object"
      },
      "MidtransWebhookDto": {
        "properties": {
          "acquirer": {
            "description": "Acquirer for QRIS",
            "example": "gopay",
            "type": "string"
          },
          "approval_code": {
            "description": "Bank approval code for card transactions",
            "example": "123456",
            "type": "string"
          },
          "channel_response_code": {
            "description": "Bank or channel response code",
            "example": "00",
            "type": "string"
          },
          "channel_response_message": {
            "description": "Bank or channel response message",
            "example": "Success",
            "type": "string"
          },
          "currency": {
            "description": "Transaction currency",
            "example": "IDR",
            "type": "string"
          },
          "customer_details": {
            "type": "object"
          },
          "expiry_time": {
            "example": "2026-10-24 21:03:58",
            "type": "string"
          },
          "fraud_status": {
            "description": "Fraud detection status (accept, challenge, deny)",
            "example": "accept",
            "type": "string"
          },
          "gross_amount": {
            "description": "Total transaction amount as formatted string",
            "example": "105000.00",
            "type": "string"
          },
          "issuer": {
            "description": "Issuer for QRIS",
            "example": "gopay",
            "type": "string"
          },
          "merchant_cross_reference_id": {
            "type": "string"
          },
          "merchant_id": {
            "description": "Midtrans merchant identifier",
            "example": "M727929445",
            "type": "string"
          },
          "order_id": {
            "description": "Merchant order identifier sent in transaction request",
            "example": "payment_notif_test_M727929445_8f2d4800-6bde-4125-92ca-55f276b40c30",
            "type": "string"
          },
          "payment_type": {
            "description": "Payment method/channel used by customer",
            "example": "gopay",
            "type": "string"
          },
          "pop_id": {
            "type": "string"
          },
          "settlement_time": {
            "description": "Timestamp when payment was settled",
            "example": "2023-11-15 22:45:13",
            "type": "string"
          },
          "signature_key": {
            "description": "SHA-512 signature key for validating notification authenticity",
            "example": "3eee83866166224898d5f566cc491d8c855dc26f0659dec7eb69cca5f314ee8860df09b0e890028ef5293df2c867e16af424ec941017a53ac9aa4f4943088caa",
            "type": "string"
          },
          "status_code": {
            "description": "Midtrans response status code",
            "example": "200",
            "type": "string"
          },
          "status_message": {
            "description": "Status message description from Midtrans",
            "example": "midtrans payment notification",
            "type": "string"
          },
          "transaction_id": {
            "description": "Midtrans unique transaction identifier (UUID)",
            "example": "513f1f01-c9da-474c-9fc9-d5c64364b709",
            "type": "string"
          },
          "transaction_status": {
            "description": "Transaction status in Midtrans (settlement, capture, pending, deny, cancel, expire)",
            "example": "settlement",
            "type": "string"
          },
          "transaction_time": {
            "description": "Timestamp when transaction occurred in Midtrans",
            "example": "2023-11-15 18:45:13",
            "type": "string"
          },
          "transaction_type": {
            "description": "Transaction type",
            "example": "on-us",
            "type": "string"
          },
          "va_numbers": {
            "description": "Array of virtual account numbers (for bank transfer payments)",
            "items": {
              "$ref": "#/components/schemas/VaNumberDto"
            },
            "type": "array"
          }
        },
        "required": [
          "order_id",
          "transaction_id",
          "payment_type",
          "transaction_status",
          "status_code",
          "gross_amount",
          "signature_key"
        ],
        "type": "object"
      },
      "PaymentOrderResponseDto": {
        "properties": {
          "amount": {
            "example": 105000,
            "type": "number"
          },
          "channel": {
            "enum": [
              "SNAP_ALL",
              "QRIS",
              "GOPAY",
              "BANK_TRANSFER",
              "CREDIT_CARD"
            ],
            "example": "SNAP_ALL",
            "type": "string"
          },
          "createdAt": {
            "example": "2026-10-24T10:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "currency": {
            "example": "IDR",
            "type": "string"
          },
          "midtransOrderId": {
            "example": "ORD-20261024-0001-TX123456",
            "type": "string"
          },
          "orderId": {
            "example": "ORD-20261024-0001",
            "type": "string"
          },
          "paidAt": {
            "example": null,
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "status": {
            "example": "PENDING",
            "type": "string"
          },
          "transactionId": {
            "example": "transaction-uuid",
            "type": "string"
          },
          "updatedAt": {
            "example": "2026-10-24T10:00:00.000Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "orderId",
          "transactionId",
          "midtransOrderId",
          "amount",
          "currency",
          "channel",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "SyncPaymentsDto": {
        "properties": {
          "orderIds": {
            "description": "List of external order IDs to sync. If omitted, all unsettled transactions will be synced.",
            "example": [
              "ORD-20261024-0001",
              "ORD-20261024-0002"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "VaNumberDto": {
        "properties": {
          "bank": {
            "description": "Bank code",
            "example": "bca",
            "type": "string"
          },
          "va_number": {
            "description": "Virtual account number",
            "example": "1234567890123456",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "api-key": {
        "in": "header",
        "name": "X-Api-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Payment Gateway Integration & Midtrans Adapter API documentation",
    "title": "Payment Integration API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "details": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "status"
                        ],
                        "type": "object"
                      },
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "type": "object"
                    },
                    "error": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "status"
                        ],
                        "type": "object"
                      },
                      "example": {},
                      "nullable": true,
                      "type": "object"
                    },
                    "info": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "status"
                        ],
                        "type": "object"
                      },
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "nullable": true,
                      "type": "object"
                    },
                    "status": {
                      "example": "ok",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The Health Check is successful"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "details": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "status"
                        ],
                        "type": "object"
                      },
                      "example": {
                        "database": {
                          "status": "up"
                        },
                        "redis": {
                          "message": "Could not connect",
                          "status": "down"
                        }
                      },
                      "type": "object"
                    },
                    "error": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "status"
                        ],
                        "type": "object"
                      },
                      "example": {
                        "redis": {
                          "message": "Could not connect",
                          "status": "down"
                        }
                      },
                      "nullable": true,
                      "type": "object"
                    },
                    "info": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "status"
                        ],
                        "type": "object"
                      },
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "nullable": true,
                      "type": "object"
                    },
                    "status": {
                      "example": "error",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The Health Check is not successful"
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/payment-methods/virtual-account": {
      "get": {
        "operationId": "PaymentMethodsController_listVirtualAccountBanks",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "List enabled virtual account banks",
        "tags": [
          "Payment Methods"
        ]
      }
    },
    "/api/v1/payments": {
      "get": {
        "operationId": "PaymentsController_listPaymentOrders",
        "parameters": [
          {
            "name": "startDate",
            "required": true,
            "in": "query",
            "description": "Inclusive start of createdAt range",
            "schema": {
              "example": "2026-10-01T00:00:00.000Z",
              "type": "string"
            }
          },
          {
            "name": "endDate",
            "required": true,
            "in": "query",
            "description": "Exclusive end of createdAt range",
            "schema": {
              "example": "2026-11-01T00:00:00.000Z",
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Filter by latest payment status",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "CAPTURE",
                "SETTLEMENT",
                "DENY",
                "CANCEL",
                "EXPIRE",
                "FAILURE",
                "REFUND",
                "CHARGEBACK",
                "PARTIAL_REFUND",
                "PARTIAL_CHARGEBACK",
                "AUTHORIZE"
              ]
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 50,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListPaymentOrdersResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "List latest payment transaction per external order",
        "tags": [
          "Payments"
        ]
      }
    },
