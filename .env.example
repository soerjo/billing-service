NODE_ENV=production
PORT=3504

# Database PostgreSQL (Internal Network soerjo-sever)
DATABASE_URL=postgresql://billing_app:3uKcnh8DtSg3ccFh11p7oO1Dr3EB@postgres_db.internal_net:5432/billing_db

# Service-to-Service Authentication & Request Signing (HMAC-SHA256)
API_KEY=your-service-api-key-secret-here

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

# Kafka Event Broker
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=billing-service

# Security & CORS
CORS_ORIGINS=http://localhost:3600,http://100.92.245.124:3600,http://100.92.245.124:3602,http://100.92.245.124:3603

# Redis (Idempotency & Distributed Lock)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_IDEMPOTENCY_TTL_SECONDS=60
